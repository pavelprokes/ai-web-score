{
  "name": "ai-web-score",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/db/migrate.ts",
    "db:deploy": "tsx src/db/migrate.ts",
    "vercel-build": "pnpm db:deploy && next build",
    "db:seed": "tsx --env-file-if-exists=.env.local src/db/seed.ts",
    "cli": "tsx --env-file-if-exists=.env.local scripts/cli.ts",
    "test:int": "vitest run src/services/pipeline.int.test.ts src/db/socket.int.test.ts src/e2e",
    "db:up": "docker compose up -d db",
    "test:e2e": "vitest run src/e2e",
    "smoke": "tsx --env-file-if-exists=.env.local scripts/smoke-providers.ts",
    "a11y": "node scripts/a11y-audit.mjs",
    "db:probe": "tsx --env-file-if-exists=.env.local scripts/db-probe.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.3",
    "next": "^16.3.8",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.16.0"
}
