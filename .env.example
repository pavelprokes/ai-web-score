# ── Database ────────────────────────────────────────────────────────────────
# Local (docker compose up -d):
DATABASE_URL=postgres://app:app@localhost:5432/ai_web_score
TEST_DATABASE_URL=postgres://app:app@localhost:5432/ai_web_score_test
# Supabase (preview/prod): transaction pooler for the app (serverless-friendly) …
#   DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# … and the session pooler / direct connection for migrations:
#   MIGRATION_DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_POOL_MAX=5

# ── Access control ──────────────────────────────────────────────────────────
# Bearer token for the admin REST API (backend-first usage, scripts, curl).
ADMIN_API_TOKEN=change-me-long-random
# Where `pnpm cli` sends requests.
API_URL=http://localhost:3000
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=change-me-long-random
# Google sign-in for the admin UI (comma-separated allowlist).
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAILS=you@example.com

# ── Measurement providers (see docs/SETUP.md; enable each after setting keys) ──
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# DATAFORSEO_BASE_URL=https://sandbox.dataforseo.com   # free sample data for format checks
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=

# ── Internal LLM (discovery, prompt design, answer analysis) ────────────────
INTERNAL_LLM_MODEL=claude-opus-5-5
ANALYZER_LLM_MODEL=claude-sonnet-5-5
# ANALYZER_SYNC=1   # analyse answers synchronously instead of via the Batches API (dev)

# ── Budget & scheduling ─────────────────────────────────────────────────────
DEFAULT_MONTHLY_BUDGET_USD=30
JOB_CONCURRENCY=8
# Delete raw provider responses older than N days (signals/answers are kept). Empty = keep forever.
RAW_RESPONSE_RETENTION_DAYS=

# ── Umami (analytics layer) ─────────────────────────────────────────────────
UMAMI_URL=
# Optional: read AI referral traffic to weight providers per domain.
UMAMI_API_TOKEN=

# ── Development ─────────────────────────────────────────────────────────────
# MOCK_PROVIDERS=1   # offline mock provider (no API keys needed)
